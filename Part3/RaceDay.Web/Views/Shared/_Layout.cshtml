@using Microsoft.AspNetCore.Http
@{
    var role = Context.Session.GetString("Role");
    var name = Context.Session.GetString("FullName");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RaceDay</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-md navbar-dark raceday-nav">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">RaceDay</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="nav">
                    <ul class="navbar-nav me-auto">
                        @if (role == "Organiser")
                        {
                        <li class="nav-item"><a class="nav-link" asp-controller="Organiser" asp-action="Dashboard">Dashboard</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Organiser" asp-action="Events">My Events</a></li>
                        }
                        else if (role == "Participant")
                        {
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Browse Events</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Participant" asp-action="Enrolments">My Enrolments</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Participant" asp-action="Results">My Results</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Participant" asp-action="Profile">Profile</a></li>
                        }
                        else
                        {
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Browse Events</a></li>
                        }
                    </ul>
                    <ul class="navbar-nav align-items-center">
                        @if (role != null)
                        {
                        <li class="nav-item text-light me-3">@name (@role)</li>
                        <li class="nav-item">
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                <button type="submit" class="btn btn-outline-light btn-sm">Log out</button>
                            </form>
                        </li>
                        }
                        else
                        {
                        <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Log in</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Register">Register</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3 pt-4">
            @RenderBody()
        </main>
    </div>
    <footer class="border-top footer text-muted">
        <div class="container">&copy; 2026 RaceDay</div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>