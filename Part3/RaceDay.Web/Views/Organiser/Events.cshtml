@model List<EventItem>
    @{ ViewData["Title"] = "My events"; }

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">My events</h2>
        <a asp-action="CreateEvent" class="btn btn-primary">Create event</a>
    </div>

    @if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
    @if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }

    @if (!Model.Any())
{
    <p class="text-muted">You have not created any upcoming events yet.</p>
}
else
{
    <table class="table align-middle">
        <thead><tr><th>Name</th><th>Date</th><th>Location</th><th>Type</th><th></th></tr></thead>
        <tbody>
            @foreach (var e in Model)
        {
            <tr>
                <td>@e.Name</td>
                <td>@e.EventDate.ToString("dd MMM yyyy")</td>
                <td>@e.Location</td>
                <td><span class="badge bg-dark">@e.EventType</span></td>
                <td class="text-end">
                    <a asp-action="Categories" asp-route-id="@e.EventId" class="btn btn-outline-primary btn-sm">Categories</a>
                    <a asp-action="Enrolments" asp-route-id="@e.EventId" class="btn btn-outline-primary btn-sm">Enrolments</a>
                    <a asp-action="Results" asp-route-id="@e.EventId" class="btn btn-outline-primary btn-sm">Results</a>
                    <a asp-action="EditEvent" asp-route-id="@e.EventId" class="btn btn-outline-secondary btn-sm">Edit</a>
                    <form asp-action="DeleteEvent" asp-route-id="@e.EventId" method="post" class="d-inline"
                          onsubmit="return confirm('Delete this event?');">
                        <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
