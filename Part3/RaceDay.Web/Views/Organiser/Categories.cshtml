@model EventItem
@{ ViewData["Title"] = "Categories"; }

<h2 class="mb-1">Categories</h2>
<p class="text-muted">@Model.Name</p>

@if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
@if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }

<div class="row">
    <div class="col-md-6">
        @if (!Model.Categories.Any())
        {
        <p class="text-muted">No categories yet.</p>
        }
        else
        {
        <ul class="list-group mb-3">
            @foreach (var c in Model.Categories)
                {
            <li class="list-group-item">@c.Name</li>
                }
        </ul>
        }
    </div>
    <div class="col-md-6">
        <form asp-action="AddCategory" asp-route-id="@Model.EventId" method="post">
            <label class="form-label">New category (e.g. Under 20, Senior, 21km)</label>
            <div class="input-group">
                <input type="text" name="name" class="form-control" maxlength="100" />
                <button type="submit" class="btn btn-primary">Add</button>
            </div>
        </form>
    </div>
</div>

<a asp-action="Events" class="btn btn-outline-secondary btn-sm mt-3">Back to my events</a>