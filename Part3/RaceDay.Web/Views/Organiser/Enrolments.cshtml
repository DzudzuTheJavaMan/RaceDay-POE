@model List<OrganiserEnrolmentItem>
    @{ ViewData["Title"] = "Enrolments"; }

    <h2 class="mb-1">Enrolments</h2>
    <p class="text-muted">@ViewBag.EventName</p>

    @if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
    @if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }

    @if (!Model.Any())
{
    <p class="text-muted">Nobody has enrolled yet.</p>
}
else
{
    <table class="table align-middle">
        <thead><tr><th>Participant</th><th>Email</th><th>Category</th><th>Status</th><th>Enrolled</th><th></th></tr></thead>
        <tbody>
            @foreach (var e in Model)
        {
            <tr>
                <td>@e.ParticipantName</td>
                <td>@e.ParticipantEmail</td>
                <td>@e.CategoryName</td>
                <td><span class="badge @(e.Status == "Confirmed" ? "bg-success" : "bg-warning text-dark")">@e.Status</span></td>
                <td>@e.EnrolmentDate.ToString("dd MMM yyyy")</td>
                <td class="text-end">
                    @if (e.Status != "Confirmed")
                    {
                    <form asp-action="ConfirmEnrolment" method="post" class="d-inline">
                        <input type="hidden" name="eventId" value="@ViewBag.EventId" />
                        <input type="hidden" name="enrolmentId" value="@e.EnrolmentId" />
                        <button type="submit" class="btn btn-success btn-sm">Confirm</button>
                    </form>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
}

    <a asp-action="Events" class="btn btn-outline-secondary btn-sm">Back to my events</a>
