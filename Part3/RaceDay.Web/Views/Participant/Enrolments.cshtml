@model List<EnrolmentItem>
@{ ViewData["Title"] = "My enrolments"; }

<h2 class="mb-3">My enrolments</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

@if (!Model.Any())
{
    <p class="text-muted">You have not enrolled in any events yet. <a asp-controller="Home" asp-action="Index">Browse events</a></p>
}
else
{
    <table class="table align-middle">
        <thead>
            <tr><th>Event</th><th>Date</th><th>Category</th><th>Status</th></tr>
        </thead>
        <tbody>
        @foreach (var e in Model)
        {
            <tr>
                <td><a asp-controller="Home" asp-action="Details" asp-route-id="@e.EventId">@e.EventName</a></td>
                <td>@e.EventDate.ToString("dd MMM yyyy")</td>
                <td>@e.CategoryName</td>
                <td><span class="badge @(e.Status == "Confirmed" ? "bg-success" : "bg-warning text-dark")">@e.Status</span></td>
            </tr>
        }
        </tbody>
    </table>
}