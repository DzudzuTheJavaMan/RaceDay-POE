@using Microsoft.AspNetCore.Http
@model EventItem
@{
    ViewData["Title"] = Model.Name;
    var role = Context.Session.GetString("Role");
}

@if (TempData["Error"] != null)
{
<div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="row">
    <div class="col-md-8">
        @if (!string.IsNullOrEmpty(Model.BannerImageUrl))
        {
        <img src="@Model.BannerImageUrl" class="img-fluid rounded mb-3" alt="Event banner" />
        }
        <h2>@Model.Name</h2>
        <span class="badge bg-dark">@Model.EventType</span>
        <p class="mt-3">@Model.Description</p>
        <ul class="list-unstyled">
            <li><strong>Date:</strong> @Model.EventDate.ToString("dd MMM yyyy, HH:mm")</li>
            <li><strong>Location:</strong> @Model.Location</li>
            <li><strong>Distance:</strong> @Model.Distance km</li>
        </ul>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back to events</a>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Categories</h5>
                @if (!Model.Categories.Any())
                {
                <p class="text-muted mb-0">No categories have been added yet.</p>
                }
                else
                {
                <ul>
                    @foreach (var c in Model.Categories)
                        {
                    <li>@c.Name</li>
                        }
                </ul>

                    if (role == "Participant")
                    {
                <form asp-controller="Participant" asp-action="Enrol" method="post">
                    <input type="hidden" name="eventId" value="@Model.EventId" />
                    <div class="mb-3">
                        <label class="form-label">Choose a category</label>
                        <select name="categoryId" class="form-select">
                            @foreach (var c in Model.Categories)
                                    {
                            <option value="@c.CategoryId">@c.Name</option>
                                    }
                        </select>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Enter event</button>
                </form>
                    }
                    else if (role == null)
                    {
                <p class="mb-0"><a asp-controller="Account" asp-action="Login">Log in</a> as a Participant to enter this event.</p>
                    }
                }
            </div>
        </div>
    </div>
</div>